# Copie este arquivo para .env NO SERVIDOR e preencha os valores reais.
# O .env nunca vai para o GitHub.

# --- Dominio -----------------------------------------------------------------
DOMINIO=sistema.exemplo.com.br
ACME_EMAIL=seu-email@exemplo.com

# --- Django ------------------------------------------------------------------
# Gere a chave com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=sistema.exemplo.com.br
CSRF_TRUSTED_ORIGINS=https://sistema.exemplo.com.br

# --- Banco de dados ----------------------------------------------------------
# Gere a senha com: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB=alfa_serra_velha
POSTGRES_USER=alfa
POSTGRES_PASSWORD=

# --- Administrador criado na primeira subida ---------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=seu-email@exemplo.com
DJANGO_SUPERUSER_PASSWORD=

# --- Copia externa do backup (rclone) -------------------------------------------
# Remoto do rclone para onde o backup.sh manda cada dump, conferindo o tamanho.
# Vazio = sem copia externa (o backup.sh avisa). Configure o remoto com "rclone config"
# logado como o usuario do projeto, o mesmo que roda o cron. Roteiro em BACKUP-EXTERNO-B2.md.
RCLONE_REMOTO=

# --- Aviso de falha do backup (healthchecks.io) ---------------------------------
# URL de ping do check. O backup.sh avisa no sucesso e em qualquer falha.
# Vazio = ninguem e avisado quando o backup falha (o backup.sh avisa no log).
HEALTHCHECK_URL=
