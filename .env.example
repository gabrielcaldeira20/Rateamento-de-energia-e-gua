# Copie para o painel do Render (Environment) ou exporte no terminal em desenvolvimento.
# Nunca coloque valores reais neste arquivo.

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Produção: False. Desenvolvimento local: True.
DEBUG=False

# Use a Internal Database URL do PostgreSQL do Render.
# Sem esta variável, o projeto usa SQLite (só para desenvolvimento).
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Endereço do serviço, sem https://. O Render também informa RENDER_EXTERNAL_HOSTNAME automaticamente.
ALLOWED_HOSTS=nome-do-servico.onrender.com

# Mesmo endereço, com https://.
CSRF_TRUSTED_ORIGINS=https://nome-do-servico.onrender.com

# Versão do Python usada pelo Render.
PYTHON_VERSION=3.13.5
